{
  "name": "Шахты24 Маркет — System Contract & Category Semantics",
  "version": "1.0.0-alpha.3.5.2",
  "type": "wordpress-plugin-bridge",
  "project": "P24 Marketplace OS / Шахты24 Маркет",
  "base_version": "1.0.0-alpha.3.5.1",
  "schema_version": "1.0",
  "modules": [
